{
  "name": "votoradar-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Test automation portfolio for VotoRadar (https://votoradar.y4tress.com)",
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit --project=mobile-chrome --project=mobile-safari",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --ui",
    "test:prod": "cross-env TEST_ENV=production playwright test",
    "test:local": "cross-env TEST_ENV=local playwright test",
    "report": "playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc"
  },
  "author": "Dalva Castro",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "zod": "^4.6.7"
  }
}
